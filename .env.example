# Copy to .env and fill in. Never commit .env (it is gitignored).

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Postgres. With Supabase: pooled (transaction pooler, :6543) for the app,
# direct (:5432) for migrations only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15
DIRECT_URL=postgresql://USER:PASSWORD@HOST.supabase.com:5432/postgres

# Supabase (storage + Realtime chat).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY
RESUME_BUCKET=resumes
# Browser vars for the Realtime chat. URL is public; anon key from Project Settings
# -> API. If the anon key is blank, chat still works but falls back to polling.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth. Generate strong random secrets (>= 32 chars), e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

# First admin, read only by `npm run seed:admin` (not required at runtime).
# Alternatively pass them as CLI args: npm run seed:admin -- <email> <password> [name]
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_ADMIN_NAME=Lab Admin
